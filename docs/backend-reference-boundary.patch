@@ -0,0 +1,25 @@
+const Calendar = require("../models/Calendar");
+const Event = require("../models/Event");
+module.exports = async function calendarOwnerBoundary(req, res, next) {
+    try {
+        const owner = req.instance?.uuid ?? req.instance;
+        const deny = () => res.status(403).json({ success: false, error: { message: "Calendar owner boundary denied" } });
+        const calendars = new Set();
+        if (req.params.calendar) calendars.add(req.params.calendar);
+        if (req.body?.calendar) calendars.add(req.body.calendar);
+        if (req.baseUrl.endsWith("/calendars") && req.params.uuid) calendars.add(req.params.uuid);
+        const events = new Set();
+        if (req.baseUrl.endsWith("/events") && req.params.uuid) events.add(req.params.uuid);
+        if (req.body?.event) events.add(req.body.event);
+        if (req.baseUrl.endsWith("/events") && req.body?.uuid) events.add(req.body.uuid);
+        for (const uuid of events) {
+            const event = await Event.findOne({ where: { uuid } });
+            if (event) calendars.add(event.calendarUuid);
+        }
+        for (const uuid of calendars) {
+            const calendar = await Calendar.findOne({ where: { uuid, ownerUuid: owner } });
+            if (!calendar) return deny();
+        }
+        next();
+    } catch (error) { next(error); }
+};
